{"key":"05ad4bc89f","origin":"transport","osm_id":null,"category":"Transport","subcategory":"Flight","community":"","lat":null,"lon":null,"verdict":"include","name":{"value":"Alaska Airlines","source":"manual"},"description":{"value":"Alaska Airlines flies nonstop between Vancouver (YVR) and Seattle (SEA) year-round, multiple times daily. Bikes travel as checked baggage in a soft- or hard-sided bike bag or case; Alaska waives its usual oversize and overweight (up to 70 lbs) fees for bicycles, so a bike costs the same as any other checked bag — $45 USD for the first bag within North America. E-bikes are not covered by that waiver and face lithium-battery restrictions; contact Alaska before travelling with one. Book at alaskaair.com.","source":"manual"},"website":{"value":"https://www.alaskaair.com/","source":"manual"},"address":{"value":null,"source":null},"phone":{"value":null,"source":null},"email":{"value":null,"source":null},"route_slugs":[],"centrally_administered":true,"bike_parking_detail":null,"provenance":{"enrichment_run":"none","enrichment_model":null,"verdict_source":"seed","category_source":"seed","category_correction_reason":null,"review_priority":false,"sidecars_applied":[]},"bike_source_urls":[{"url":"https://www.alaskaair.com/content/travel-info/baggage/special-baggage/traveling-with-sporting-equipment"}],"required_criteria":{"Accommodates bicycles":{"value":true,"detail":null,"source":"manual","date":"2026-07-10"}},"optional_amenities":{"Bagged bikes OK":{"value":true,"detail":null,"source":"manual","date":"2026-07-10"},"Boxed bikes OK":{"value":true,"detail":null,"source":"manual","date":"2026-07-10"},"E-bikes OK":{"value":false,"detail":null,"source":"manual","date":"2026-07-10"},"Bike fee applies":{"value":true,"detail":null,"source":"manual","date":"2026-07-10"}},"unmapped_criteria":{},"region":null,"ownership":"Buy BC (independent)","indigenous_role":[],"tier":"welcoming"}