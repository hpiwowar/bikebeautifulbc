{"key":"8756f55c9e","origin":"transport","osm_id":null,"category":"Transport","subcategory":"Flight","community":"","lat":null,"lon":null,"verdict":"include","name":{"value":"Flair Airlines","source":"manual"},"description":{"value":"Flair Airlines is a Canadian ultra-low-cost carrier flying into Vancouver, Abbotsford, Kelowna, and Victoria, with Calgary among its network connections. Bikes travel as \"Sports Equipment\": they must be packed in a hard case or box, and cost $79-$104 CAD if added online at least 24 hours ahead or $99-$139 CAD at the airport, charged per flight on top of the standard checked-bag fee. E-bikes are not accepted in any form, checked or carry-on, due to lithium-battery fire-risk rules. Confirm current fees and space before travelling, since low-cost-carrier ancillary pricing changes often.","source":"manual"},"website":{"value":"https://www.flyflair.com/","source":"manual"},"address":{"value":null,"source":null},"phone":{"value":null,"source":null},"email":{"value":null,"source":null},"route_slugs":[],"centrally_administered":true,"bike_parking_detail":null,"provenance":{"enrichment_run":"none","enrichment_model":null,"verdict_source":"seed","category_source":"seed","category_correction_reason":null,"review_priority":false,"sidecars_applied":[]},"bike_source_urls":[{"url":"https://www.flyflair.com/travel-info/baggage/sports-equipment"}],"required_criteria":{"Accommodates bicycles":{"value":true,"detail":null,"source":"manual","date":"2026-07-10"}},"optional_amenities":{"Boxed bikes OK":{"value":true,"detail":null,"source":"manual","date":"2026-07-10"},"Bagged bikes OK":{"value":false,"detail":null,"source":"manual","date":"2026-07-10"},"E-bikes OK":{"value":false,"detail":null,"source":"manual","date":"2026-07-10"},"Bike fee applies":{"value":true,"detail":null,"source":"manual","date":"2026-07-10"},"Advance booking required":{"value":true,"detail":null,"source":"manual","date":"2026-07-10"}},"unmapped_criteria":{},"region":null,"ownership"