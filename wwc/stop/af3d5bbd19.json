{"key":"af3d5bbd19","origin":"transport","osm_id":null,"category":"Transport","subcategory":"Bus / Public Transit","community":"Vancouver","lat":null,"lon":null,"verdict":"include","name":{"value":"FlixBus","source":"opus_4.6"},"description":{"value":"FlixBus runs a cross-border coach route between Vancouver and Seattle, with stops in Bellingham and Everett, Washington, operated for FlixBus by local partner MTRWestern. The Vancouver stop is Pacific Central Station, Bus Bay 3. Bikes travel on an exterior rack when space allows, or as boxed/bagged baggage for folding bikes only, for roughly CAD 18.50-37 depending on the fare. E-bikes, tandems, and trailers are not accepted, and space is not guaranteed, so book the bike as an add-on in advance rather than showing up at the curb. Because this route runs on a partner operator's buses rather than FlixBus's own fleet, call ahead to confirm the bike policy applies as described.","source":"manual"},"website":{"value":"https://www.flixbus.ca","source":"verification_consensus"},"address":{"value":null,"source":null},"phone":{"value":null,"source":null},"email":{"value":null,"source":null},"route_slugs":[],"centrally_administered":true,"bike_parking_detail":null,"provenance":{"enrichment_run":"none","enrichment_model":null,"verdict_source":"seed","category_source":"seed","category_correction_reason":null,"review_priority":false,"sidecars_applied":["wow"]},"bike_source_urls":[{"url":"https://www.flixbus.com/service/bike-travel"}],"required_criteria":{"Accommodates bicycles":{"value":true,"detail":"CAD $18.50-$37.00, add bike during booking; limited space; folding bikes as luggage; no e-bikes","source":"accreditation_jul2026","date":"2026-05-16"}},"optional_amenities":{"Advance booking required":{"value":true,"detail":null,"source":"sonnet_4.6","date":"2026-05-16"},"Bagged bikes OK":{"value":true,"detail":null,"source":"sonnet_4.6","date":"2026-05-16"},"Bike fee applies":{"value":true,"detail":null,"source":"sonnet_4.6","date":"2