{"key":"bc8da050ed","origin":"transport","osm_id":null,"category":"Transport","subcategory":"Ferry","community":"","lat":null,"lon":null,"verdict":"include","name":{"value":"Alaska Marine Highway","source":"manual"},"description":{"value":"The Alaska Marine Highway (Alaska's state ferry) runs weekly between Bellingham, WA and Southeast Alaska, calling at Ketchikan, Juneau, Haines, and Skagway. It does not stop in Prince Rupert or anywhere else in BC in 2026. Bikes roll on as their own ticketed item and must be rideable (no boxed bikes); e-bikes are allowed if you push them on and off. The bike fare isn't published; call 1-800-642-0066.","source":"manual"},"website":{"value":"https://dot.alaska.gov/amhs/","source":"manual"},"address":{"value":null,"source":null},"phone":{"value":null,"source":null},"email":{"value":null,"source":null},"route_slugs":[],"centrally_administered":true,"bike_parking_detail":null,"provenance":{"enrichment_run":"none","enrichment_model":null,"verdict_source":"seed","category_source":"seed","category_correction_reason":null,"review_priority":false,"sidecars_applied":[]},"bike_source_urls":[{"url":"https://dot.alaska.gov/amhs/doc/02_010A.pdf"}],"required_criteria":{"Accommodates bicycles":{"value":true,"detail":null,"source":"manual","date":"2026-10-16"}},"optional_amenities":{"Walk-on bikes":{"value":true,"detail":null,"source":"manual","date":"2026-10-16"},"Unboxed bikes OK":{"value":true,"detail":"must be rideable; boxed or disassembled bikes not accepted","source":"manual","date":"2026-10-16"},"Boxed bikes OK":{"value":false,"detail":null,"source":"manual","date":"2026-10-16"},"Bike fee applies":{"value":true,"detail":"fare not published; call 1-800-642-0066","source":"manual","date":"2026-10-16"},"E-bikes OK":{"value":true,"detail":"pushed on and off the ramp","source":"manual","date":"2026-10-16"}},"unmapped_criteria":{},"region":null,"ownership":"Buy BC (independent)","indigenous_role":[],"tier":"welcoming"}